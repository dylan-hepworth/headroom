{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Headroom",
  "version": "../package.json",
  "identifier": "io.github.dylan-hepworth.headroom",
  "build": {
    "devUrl": "http://localhost:1431",
    "beforeDevCommand": "npm run ui",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist"
  },
  "app": { "windows": [], "macOSPrivateApi": true, "security": { "csp": null } },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": { "icons/Assets.car": "Assets.car" },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "icons/dmg-background.tiff",
        "windowSize": { "width": 660, "height": 500 },
        "appPosition": { "x": 150, "y": 185 },
        "applicationFolderPosition": { "x": 510, "y": 185 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxNUUyQzYxNjRENDU1MTIKUldRU1ZkUmtZU3hlSVhCRVQrSnA2ajNzaUJlUStmUk1xMGxpUzdLU3NXWlZVMWp4Yk40bWZWZ3IK",
      "endpoints": ["https://github.com/dylan-hepworth/headroom/releases/latest/download/latest.json"]
    }
  }
}
